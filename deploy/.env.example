# Deployment target. Copy to deploy/.env and fill in — the real file is
# gitignored. Both azure.sh and azure.ps1 load it automatically.
#
# An exported environment variable, or an explicit script argument, takes
# precedence over anything set here: the file is the convenient default,
# never an override.
#
# The three REQUIRED settings have no built-in defaults on purpose. A
# script that ships with someone's real registry baked in is one typo away
# from deploying into the wrong subscription.

# --- required ---------------------------------------------------------

# Resource group holding the Container Apps environment and the registry.
RESOURCE_GROUP=my-resource-group

# Azure Container Registry, NAME ONLY — not the login server.
# "myregistry", not "myregistry.azurecr.io".
ACR_NAME=myregistry

# Container Apps environment the two apps live in.
ACA_ENV=my-container-apps-env

# --- optional ---------------------------------------------------------

# Postgres connection string. Stored as a Container Apps secret (db-url)
# and injected as DATABASE_URL, never as a plain environment variable.
#
# The `+psycopg` suffix is required: SQLAlchemy resolves a bare
# postgresql:// to psycopg2, which is not installed, and the container then
# dies at startup rather than on first query.
#
# WITHOUT THIS the API runs on SQLite inside the container and every run
# and review decision is lost on restart or scale-to-zero.
# PG_CONN=postgresql+psycopg://user:password@myserver.postgres.database.azure.com:5432/sdoc?sslmode=require

# Enables Firebase token verification on write endpoints. Unset means auth
# is off and the API accepts unauthenticated writes.
# FIREBASE_PROJECT_ID=my-firebase-project
